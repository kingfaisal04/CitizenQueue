# ============================================================================
# CITIZENQUEUE BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ============================================================================
# Copy this file to .env and provide your actual values.
# NEVER commit your actual .env file or real secrets to source control.

# Server & Network
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://citizenqueue.vercel.app

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/citizenqueue?retryWrites=true&w=majority&appName=CitizenQueueCluster

# Authentication & JWT Secrets (Generate with `openssl rand -hex 64`)
JWT_ACCESS_SECRET=replace_with_a_secure_random_64_character_hex_secret_key
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_character_hex_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Configuration for Cross-Origin (Vercel Frontend + Render Backend)
# In production on different subdomains under a shared apex (e.g. app.domain.com and api.domain.com), set to .domain.com
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Private Cloud Object Storage (S3-Compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER=mock
STORAGE_ENDPOINT=
STORAGE_REGION=af-south-1
STORAGE_BUCKET=citizenqueue-documents-vault
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_URL_EXPIRATION_SECONDS=900

# Email Notification Service Adapter
EMAIL_PROVIDER=none
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CitizenQueue Admissions Desk <admissions@citizenqueue.edu.gh>"

# Institutional Administrative Access
ADMIN_REGISTRATION_KEY=GES-SHS-2026

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
AUTH_RATE_LIMIT_MAX_REQUESTS=10
